spring.application.name=bebetter-backend
spring.data.mongodb.uri=mongodb://localhost:27017/BeBetter
logging.level.org.springframework.security=DEBUG
# OpenRouter config (OpenAI-compatible chat API) - get a key at https://openrouter.ai/keys
openrouter.api.url=https://openrouter.ai/api/v1/chat/completions
openrouter.api.key=YOUR_OPENROUTER_API_KEY
# Cheap model, good in French/English and at JSON output (~$0.075/M input, $0.20/M output)
openrouter.model=mistralai/mistral-small-3.2-24b-instruct
# System prompt sent to the AI coach
app.prompt.subject-coach=classpath:prompts/subject-coach-prompt.txt
# CORS config (comma-separated list of allowed front-end origins)
app.cors.allowed-origins=http://localhost:4200
